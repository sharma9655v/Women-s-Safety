DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mapforwomen
REDIS_URL=redis://localhost:6379/0
OSRM_BASE_URL=http://localhost:5000
WEATHER_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: load road segments from a GeoJSON file (dev/test). PostGIS is the
# production source once provisioned.
SEGMENTS_GEOJSON=
# Phase 5: production must set a real key. Empty + development uses a dev-only
# key for local demos; admin endpoints are disabled in production without a key.
ADMIN_KEY=
# Comma-separated origins allowed by CORS (default: local web app only).
CORS_ORIGINS=http://localhost:3000
# Per-client route request limit per minute (abuse protection, same pattern
# as report rate limiting).
ROUTE_RATE_LIMIT_PER_MINUTE=30
# Fernet key (urlsafe-base64, 32 bytes) for report image encryption. Empty
# derives a deterministic dev key — never use that outside development.
REPORT_ENCRYPTION_KEY=

# --- Computer vision --------------------------------------------------------
# "mock" (default) serves a clearly-labelled development implementation that
# never pretends to be real ML inference; "disabled" turns the CV API off
# (503); "real" loads a validated backend module (see CV_REAL_BACKEND_MODULE).
CV_BACKEND=mock
# Directory holding CV checkpoints (models/ by default).
CV_MODEL_DIR=models
# Upper bound for a single CV inference call (seconds).
CV_INFERENCE_TIMEOUT_S=10.0
# Real backend module path, e.g. app.cv.keras_impl. Empty means "real backend
# not deployed" — required for CV_BACKEND=real.
CV_REAL_BACKEND_MODULE=
