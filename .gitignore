# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.pyc

# Env & secrets
.env
.env.local
.env.production

# Data artifacts (large, versioned externally)
data/*.osm.pbf
data/*.mbtiles
data/*.gf-*
data/osrm/
data/processed/
ml/models/*.joblib
ml/models/*.json
ml/experiments/*.json
ml/experiments/*.csv

# Dataset pipeline outputs (caches, exports, version manifests, lineage)
# Raw source files and built datasets are reproducible from sources.yaml;
# never commit downloaded third-party data or generated exports.
ml/data/cache/
ml/data/exports/
ml/data/versions/
ml/cache_*/
**/wsdp_cache_*/
ml/.venv/
ml/map_for_women_ml.egg-info/

# Build output
apps/web/.next/
apps/web/out/
dist/
build/

# Next.js
apps/web/.env*.local

# Misc
.DS_Store
Thumbs.db
*.log
.coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
# Database backups
infra/backups/
*.dump

# Ephemeral per-install report encryption key (dev fallback; never commit)
.report_encryption_key
